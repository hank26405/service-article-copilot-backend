# database setting

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=article_copilot
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=5000

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# 快取配置
CACHE_ARTICLE_TTL=3600
CACHE_ENABLE_WRITE_THROUGH=false
CACHE_ENABLE_READ_THROUGH=true

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

Large_LLM_MODEL_NAME=openai/gpt-4.1
Small_LLM_MODEL_NAME=openai/gpt-4.1-mini
RAG_MODEL_NAME=text-embedding-3-small

CPU_CORES=1
WORKERS_PER_CORE=1
MAX_WORKERS=1
WEB_CONCURRENCY=1
GUNICORN_THREADS=1
UVICORN_WORKERS=1

PORT=8888

ROOT_PATH=/llm

SECRET_KEY=fet3817

ROOT_USER_EMAIL
ROOT_USER_PASSWORD