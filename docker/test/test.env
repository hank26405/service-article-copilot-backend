# Test environment variables for unit testing
# These are mock values and should not be used in production

# MongoDB 配置
MONGODB_URI=mongodb://test-mongo:27017/
MONGODB_DATABASE=article_copilot
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=5000

# Redis 配置
REDIS_HOST=test-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# 快取配置
CACHE_ARTICLE_TTL=3600
CACHE_ENABLE_WRITE_THROUGH=false
CACHE_ENABLE_READ_THROUGH=true


# Test server settings
CPU_CORES=1
WORKERS_PER_CORE=1
MAX_WORKERS=1
WEB_CONCURRENCY=1
GUNICORN_THREADS=1
UVICORN_WORKERS=1

PORT=8888
LOG_LEVEL=DEBUG

# Test mode flag
TESTING=true

SECRET_TOKEN=test_secret_token

REDIS_HOST=test-redis